# Next.js server -> Python DeepFace (never expose these values in client code)
FACE_API_URL=http://127.0.0.1:8001
FACE_API_KEY=replace-with-the-same-secret-used-by-python
FACE_ALLOWED_ORIGINS=https://infinityshop.click,http://localhost:3001
FACE_ENABLE_DOCS=false
FACE_MAX_IMAGE_BYTES=8388608

# Secrets bắt buộc phía server (tạo chuỗi ngẫu nhiên dài, không commit giá trị thật)
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
HR_DATA_KEY=replace-with-a-separate-32-byte-random-key

# Twilio Verify dùng để gửi mã khôi phục mật khẩu qua email hoặc SMS
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=replace-with-twilio-verify-service-sid

# Google OAuth và webhook thanh toán (chỉ cấu hình ở server/Cloudflare Secrets)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
CASSO_WEBHOOK_SECRET=replace-with-casso-webhook-secret

# Tên miền chính và callback đăng nhập Google của Infinity Store
GOOGLE_REDIRECT_URI=https://infinityshop.click/api/account/google/callback
